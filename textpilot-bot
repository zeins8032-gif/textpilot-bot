async def start(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    context.user_data.clear()

    await update.message.reply_text(
        "Привет! Я TextPilotRuBot 🤖\n\n"
        "Помогу оформить заявку на создание текста.\n"
        "Выбери, что тебе нужно:",
        reply_markup=MENU,
    )


